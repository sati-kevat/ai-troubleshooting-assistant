# ---------------------------------------------------------------
# Backend configuration - copy this file to ".env" and edit it.
# ".env" is git-ignored and blocked from web access by .htaccess.
# Never put real secrets in this example file.
# ---------------------------------------------------------------

# Application
APP_TIMEZONE=Asia/Kolkata
# Comma-separated list of frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL / MariaDB (XAMPP defaults: user root, empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=troubleshoot_assistant
DB_USER=root
DB_PASS=

# AI provider
#   AI_PROVIDER=demo    -> no AI model is used; answers are built from the
#                          retrieved knowledge-base articles with templates
#   AI_PROVIDER=ollama  -> uses a local Ollama model (free, runs on this PC,
#                          no API key). Install Ollama first - see README.
# AI_PROVIDER=demo

AI_PROVIDER=ollama

# Ollama settings (used only when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must be a model you have downloaded with "ollama pull <name>"
OLLAMA_MODEL=llama3.2:3b
# Context window in tokens (the prompt with 3 articles needs about 2,500)
OLLAMA_NUM_CTX=8192
# Maximum tokens the model may generate per answer
OLLAMA_NUM_PREDICT=1024
# Local models on a CPU can be slow; after this the template answer is used
AI_TIMEOUT_SECONDS=120
